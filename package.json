{
  "name": "playwright-checkpoint",
  "version": "0.3.0",
  "description": "Structured page snapshots for Playwright — screenshots, accessibility, web vitals, and auto-generated documentation from your e2e tests",
  "keywords": [
    "playwright",
    "testing",
    "checkpoint",
    "e2e",
    "accessibility",
    "web-vitals",
    "documentation"
  ],
  "license": "MIT",
  "author": "pm990320",
  "repository": "pm990320/playwright-checkpoint",
  "bugs": {
    "url": "https://github.com/pm990320/playwright-checkpoint/issues"
  },
  "homepage": "https://github.com/pm990320/playwright-checkpoint",
  "private": false,
  "type": "module",
  "packageManager": "bun@1.2.15",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "playwright-checkpoint": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "require": "./dist/cli/index.cjs"
    },
    "./teardown": {
      "types": "./dist/teardown.d.ts",
      "import": "./dist/teardown.js",
      "require": "./dist/teardown.cjs"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js",
      "require": "./dist/components.cjs"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js",
      "require": "./dist/mcp/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "bun run build",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@playwright/test": "^1.59.1"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@axe-core/playwright": "^4.10.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.1.0",
    "jiti": "^2.6.1",
    "playwright-core": "^1.59.1",
    "prettier": "^3.8.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  }
}
